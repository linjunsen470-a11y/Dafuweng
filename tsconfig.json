{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "lib": ["ESNext", "DOM"],
    "types": ["vitest/globals", "node"],
    "skipLibCheck": true
  },
  "include": ["src", "tests", "vite.config.js"]
}
